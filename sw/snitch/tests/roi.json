[
    <% N_TILES = 3 %>

    % for cluster in range(0,15):
        // Compute cores
        % for j in range(0, 8):
        {
            "thread": "${f'hart_{cluster*9+j+1}'}",
            "roi": [
            % for i in range(0, N_TILES):
                {"idx": ${2 * i + 1}, "label": "${f'tile_reduction_{i}'}"},
            % endfor
            ]
        },
        % endfor

        // DMA core
        {

            "thread": "${f'hart_{cluster*9+9}'}",
            "roi": [
                % for i in range(0, N_TILES):
                    {"idx": ${2 * i + 1}, "label": "${f'dma_tile_{i}'}"},
                % endfor
            ]
        },
    % endfor
]